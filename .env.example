# ──────────────────────────────────────────────────────────────────────────
#  CITOS static site — contact form settings (example) (read by contact.php)
#  Copy to .env and fill in the SMTP credentials. Keep it OUTSIDE the public web folder if you can
#  (contact.php looks one folder up first); .htaccess blocks it otherwise.
# ──────────────────────────────────────────────────────────────────────────

# ─── SMTP ─────────────────────────────────────────────────────────────────
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it into SMTP_PASS.
# 465 = implicit TLS, 587 = STARTTLS. SMTP_SECURE is inferred from the port if left blank.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password

# "From" header. With Gmail this must be SMTP_USER or a verified alias.
MAIL_FROM="CITOS Research <your-account@gmail.com>"

# Comma-separated list of people who receive contact-form submissions.
CONTACT_RECIPIENTS=IT2207184@my.sliit.lk,saifulis.4965@gmail.com

# Send a confirmation email back to the person who filled in the form.
CONTACT_SEND_AUTOREPLY=true
